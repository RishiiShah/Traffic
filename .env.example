# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and must never be committed.

# --- Groq (license-plate OCR via hosted vision model) ---
GROQ_API_KEY=

# --- RTO vehicle lookup (RapidAPI: PUC / Insurance status) ---
X_RAPIDAPI_KEY=
X_RAPIDAPI_HOST=rto-vehicle-information-india.p.rapidapi.com

# --- AWS S3 (challan PDF storage) ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=traffic-violation-pdfs

# --- Twilio (SMS notifications) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Recipient used for demo violation notifications.
DEMO_PHONE_NUMBER=

# Notifications are MOCKED by default (no real SMS is sent and no Twilio
# client is created). Set this to true only when you intentionally want to
# send real messages with valid Twilio credentials above.
ENABLE_NOTIFICATIONS=false

# --- PDF generation ---
# Optional: absolute path to the wkhtmltopdf binary. If unset, the app looks
# for `wkhtmltopdf` on your PATH (install via brew/apt), then the default
# Windows location.
WKHTMLTOPDF_PATH=
